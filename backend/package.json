{
  "name": "nurman-course-backend",
  "version": "1.0.0",
  "description": "Backend for Nurman Course LMS Sederhana",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "seed": "ts-node prisma/seed.ts",
    "test": "npm run test:clients && npm run test:api",
    "test:clients": "node --test tests/clients.test.cjs",
    "test:api": "vitest run",
    "test:watch": "vitest",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nurman-course/shared": "*",
    "@prisma/client": "^5.18.0",
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "4.22.3",
    "morgan": "1.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.24",
    "@types/supertest": "6.0.3",
    "prisma": "^5.18.0",
    "supertest": "7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
