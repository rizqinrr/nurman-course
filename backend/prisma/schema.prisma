datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String       @id @default(uuid())
  role        String       // "admin" | "peserta"
  name        String
  phone       String
  email       String?      @unique
  createdAt   DateTime     @default(now()) @map("created_at")
  enrollments Enrollment[]
  progresses  Progress[]

  @@map("users")
}

model Program {
  id           String        @id @default(uuid())
  slug         String        @unique
  name         String
  description  String
  category     String        // "materi" | "jenjang" | "calistung"
  basePrice    Float?        @map("base_price")
  active       Boolean       @default(true)
  roadmapSteps RoadmapStep[]
  sessions     Session[]
  enrollments  Enrollment[]

  @@map("programs")
}

model RoadmapStep {
  id            String         @id @default(uuid())
  programId     String         @map("program_id")
  program       Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  order         Int
  title         String
  bodyText      String         @map("body_text") // Markdown plain
  level         String?
  materialItems MaterialItem[]
  progresses    Progress[]

  @@map("roadmap_steps")
}

model Session {
  id            String         @id @default(uuid())
  programId     String         @map("program_id")
  program       Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  startsAt      DateTime       @map("starts_at")
  endsAt        DateTime       @map("ends_at")
  location      String?
  capacity      Int?
  status        String         // "scheduled" | "cancelled" | "completed"
  materialItems MaterialItem[]

  @@map("sessions")
}

model MaterialItem {
  id            String       @id @default(uuid())
  roadmapStepId String?      @map("roadmap_step_id")
  roadmapStep   RoadmapStep? @relation(fields: [roadmapStepId], references: [id], onDelete: Cascade)
  sessionId     String?      @map("session_id")
  session       Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title         String
  bodyText      String       @map("body_text") // Markdown plain
  order         Int

  @@map("material_items")
}

model Enrollment {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId String    @map("program_id")
  program   Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  status    String    // "active" | "completed" | "cancelled"
  startedAt DateTime  @default(now()) @map("started_at")
  invoices  Invoice[]

  @@map("enrollments")
}

model Invoice {
  id           String     @id @default(uuid())
  enrollmentId String     @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  amount       Float
  status       String     // "unpaid" | "waiting" | "paid"
  dueAt        DateTime   @map("due_at")
  paidAt       DateTime?  @map("paid_at")
  note         String?

  @@map("invoices")
}

model Progress {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapStepId String      @map("roadmap_step_id")
  roadmapStep   RoadmapStep @relation(fields: [roadmapStepId], references: [id], onDelete: Cascade)
  status        String      // "in_progress" | "completed"
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("progresses")
}
